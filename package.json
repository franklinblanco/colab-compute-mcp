{
  "name": "colab-compute-mcp",
  "version": "0.1.0",
  "description": "Share a warm Google Colab build and test pool across local MCP clients",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "colab-compute-mcp": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:live": "pnpm run build && node test/live.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
